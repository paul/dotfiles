{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-bell@0.1.0",
    "@slkiser/opencode-quota",
    "opencode-browser",
    "/home/rando/.local/share/mise/installs/node/22.21.1/lib/node_modules/@rynfar/meridian/plugin/meridian.ts"
  ],
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/deepseek-v4-flash",
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": true
    },
    "penpot": {
      "type": "remote",
      "url": "https://design.penpot.app/mcp/stream?userToken={env:PENPOT_MCP_TOKEN}"
    },
  },
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "rubber-ducky": {
      "model": "opencode-go/deepseek-v4-flash"
    },
  },
  "formatter": {
    "rubocop": {
      "disabled": true
    },
    "standardrb": {
      "disabled": true
    }
  },
  "lsp": {
    "ruby-lsp": {
      "disabled": true
    }
  },
  "permission": {
    "bash": {
      "terraform*": "deny",
      "terraform fmt*": "allow",
      "terraform validate*": "allow",
      "aws*": "ask",
    },
    "external_directory": {
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
    }
  },
  "disabled_providers": [
    "github-copilot",
  ],
  "provider": {
    "opencode": {
      "blacklist": [
        "claude-sonnet-4-6",
        "claude-haiku-4-5",
        "claude-opus-4-6",
        "claude-fable-5",
        "claude-opus-4-8",
        "claude-opus-4-1",
        "claude-sonnet-4-5",
        "claude-sonnet-4",
        "claude-3-5-haiku",
        "claude-opus-4-7",
        "claude-opus-4-5",
        "claude-sonnet-5",
        "claude-opus-5",
        "glm-5",
        "glm-5.1",
        "glm-5.2",
        "gpt-5",
        "gpt-5-codex",
        "gpt-5-nano",
        "gpt-5.1",
        "gpt-5.1-codex",
        "gpt-5.1-codex-max",
        "gpt-5.1-codex-mini",
        "gpt-5.2",
        "gpt-5.2-codex",
        "gpt-5.3-codex",
        "gpt-5.3-codex-spark",
        "gpt-5.4",
        "gpt-5.4-mini",
        "gpt-5.4-nano",
        "gpt-5.4-pro",
        "gpt-5.5",
        "gpt-5.5-pro",
        "gpt-5.6-luna",
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "grok-4.5",
        "grok-build-0.1",
      ]
    }
  },
  "experimental": {
    "quotaToast": {
      "enableToast": false
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-bell@0.1.0",
    "@slkiser/opencode-quota",
    "opencode-browser",
    "/home/rando/.local/share/mise/installs/node/22.21.1/lib/node_modules/@rynfar/meridian/plugin/meridian.ts"
  ],
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/deepseek-v4-flash",
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": true
    },
    "penpot": {
      "type": "remote",
      "url": "https://design.penpot.app/mcp/stream?userToken={env:PENPOT_MCP_TOKEN}"
    },
  },
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "rubber-ducky": {
      "model": "opencode-go/deepseek-v4-flash"
    },
  },
  "formatter": {
    "rubocop": {
      "disabled": true
    },
    "standardrb": {
      "disabled": true
    }
  },
  "lsp": {
    "ruby-lsp": {
      "disabled": true
    }
  },
  "permission": {
    "bash": {
      "terraform*": "deny",
      "terraform fmt*": "allow",
      "terraform validate*": "allow",
      "aws*": "ask",
    },
    "external_directory": {
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
    }
  },
  "experimental": {
    "quotaToast": {
      "enableToast": false
    }
  }
}

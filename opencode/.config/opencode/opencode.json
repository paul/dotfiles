{
	"$schema": "https://opencode.ai/config.json",
	"plugins": [
		"@slkiser/opencode-quota@latest",
		"{env:HOME}/.local/share/mise/installs/node/latest/lib/node_modules/@rynfar/meridian/dist/meridian-v2",
	],
	"model": "opencode-go/deepseek-v4.1-flash",
	"agents": {
		"title": {
			"model": "opencode-go/deepseek-v4.1-flash",
		},
	},
	"mcp": {
		"servers": {
			"chrome-devtools": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"chrome-devtools-mcp@latest",
					"--no-usage-statistics",
					"--no-performance-crux",
				],
			},
			"penpot": {
				"type": "remote",
				"url":  "https://design.penpot.app/mcp/stream?userToken={env:PENPOT_MCP_TOKEN}",
			},
		},
	},
	"formatter": {
		"rubocop": {
			"disabled": true,
		},
		"standardrb": {
			"disabled": true,
		},
	},
	"lsp": {
		"ruby-lsp": {
			"disabled": true,
		},
	},
	"permissions": [
		{ "action": "shell", "resource": "terraform*", "effect": "deny" },
		{ "action": "shell", "resource": "terraform fmt*", "effect": "allow" },
		{ "action": "shell", "resource": "terraform validate*", "effect": "allow" },
		{ "action": "shell", "resource": "aws*", "effect": "ask" },
		{ "action": "shell", "resource": "sudo*", "effect": "ask" },
		{ "action": "external_directory", "resource": "*", "effect": "ask" },
		{ "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
		{ "action": "external_directory", "resource": "/private/tmp/**", "effect": "allow" },
	],
	"policies": [
		{ "action": "provider.use", "resource": "github-copilot", "effect": "deny" },
	],
	"providers": {
		"anthropic": {},
		"openai":    {},
	},
	"experimental": {
		"quotaToast": {
			"enabledProviders": ["anthropic", "openai", "opencode-go"],
			"enableToast": false,
		},
	},
}

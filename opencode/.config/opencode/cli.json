{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "plugins": [
    "@slkiser/opencode-quota@latest",
    "./herdr-opencode"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": true
  }
}

#!/usr/bin/env bash
# get-preview [-C <dir>]
#
# Prints the running dev URL of the checkout at <dir> as one JSON line: {tool, url, running}.
# Exits 1 when the repo declares no preview tool.
#
# Declare one once per repo (all worktrees share it):
#   git config preview.tool plane

set -uo pipefail

dir=.
while (($#)); do
  case $1 in
    -C) dir=$2; shift 2 ;;
    -h|--help) sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "get-preview: unknown argument: $1" >&2; exit 2 ;;
  esac
done
cd "$dir" 2>/dev/null || { echo "get-preview: no such folder: $dir" >&2; exit 2; }

tool=$(git config --get preview.tool 2>/dev/null)
[[ -n $tool ]] || exit 1

# Caddy answers 502 for a route whose apps are stopped; no answer at all is 000.
up() {
  local code
  code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 2 "$1")
  [[ $code != 000 && $code != 502 ]]
}

plane() {
  local git_dir common host=plane.localhost
  git_dir=$(git rev-parse --absolute-git-dir) || return 1
  common=$(git rev-parse --path-format=absolute --git-common-dir) || return 1
  # A linked worktree has no runtime until its first `mise run prepare`.
  if [[ $git_dir != "$common" ]]; then
    [[ -f $git_dir/plane-runtime ]] || return 1
    host="$(<"$git_dir/plane-runtime").$host"
  fi
  local url="https://manage.$host"
  local running=false
  up "$url/up" && running=true
  jq -nc --arg url "$url" --argjson running "$running" '{tool: "plane", url: $url, running: $running}'
}

case $tool in
  plane) plane ;;
  *) echo "get-preview: unknown preview.tool: $tool" >&2; exit 2 ;;
esac

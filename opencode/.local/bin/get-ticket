#!/usr/bin/env bash
# get-ticket [-C <dir>] [--full] <text>...
#
# Finds the first ticket id in <text> for the tracker the repo at <dir> declares,
# and prints it as one JSON line: {tool, id, title, url, status}.
# --full adds body as Markdown, comments [{author, created, body}] and raw (the tracker's own output).
# Exits 1 when the repo declares no tracker, or no text names a ticket it knows.
#
# Declare a tracker once per repo (all worktrees share it):
#   git config ticket.tool linear|jira|tk|github
# A repo with a .tickets/ folder uses tk without the setting.

set -uo pipefail

dir=.
full=false
texts=()
while (($#)); do
  case $1 in
    -C) dir=$2; shift 2 ;;
    --full) full=true; shift ;;
    -h|--help) sed -n '2,11s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) texts+=("$1"); shift ;;
  esac
done
cd "$dir" 2>/dev/null || { echo "get-ticket: no such folder: $dir" >&2; exit 2; }
((${#texts[@]})) || exit 1

tool=$(git config --get ticket.tool 2>/dev/null)
if [[ -z $tool ]]; then
  top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  [[ -d $top/.tickets ]] && tool=tk
fi
[[ -n $tool ]] || exit 1

# Candidate ids in the order the texts give them, each once.
candidates() {
  local pattern=$1 text
  for text in "${texts[@]}"; do
    grep -oiE "$pattern" <<<"$text"
  done | awk '!seen[$0]++'
}

# Atlassian Document Format to Markdown.
ADF='def adf($ind):
  def inline:
    if type == "array" then map(inline) | join("")
    elif type != "object" then ""
    elif .type == "text" then
      .text as $t | (.marks // []) as $m
      | (if ($m | map(.type) | index("code")) then "`\($t)`" else $t end)
      | (if ($m | map(.type) | index("strong")) then "**\(.)**" else . end)
      | (if ($m | map(.type) | index("em")) then "*\(.)*" else . end)
      | (if ($m | map(.type) | index("strike")) then "~~\(.)~~" else . end)
      | (if ($m | map(.type) | index("link")) then "[\(.)](\($m[] | select(.type == "link") | .attrs.href))" else . end)
    elif .type == "hardBreak" then "  \n"
    elif .type == "mention" then "@\(.attrs.text // .attrs.id)"
    elif .type == "emoji" then (.attrs.text // .attrs.shortName // "")
    elif .type == "inlineCard" then (.attrs.url // "")
    elif .type == "status" then "`\(.attrs.text)`"
    else ((.content // []) | map(inline) | join(""))
    end;
  def cell:
    (.content // [])
    | map(if .type == "paragraph" then ((.content // []) | map(inline) | join("")) else adf($ind) end)
    | join(" ") | gsub("\\|"; "\\|") | gsub("\n"; " ");
  def table:
    (.content // []) as $rows
    | ($rows[0].content // [] | map(cell)) as $head
    | ["\($ind)| \($head | join(" | ")) |", "\($ind)| \($head | map("---") | join(" | ")) |"]
      + ($rows[1:] | map("\($ind)| \((.content // []) | map(cell) | join(" | ")) |"))
    | join("\n");
  def item($ordered; $n):
    .content as $c
    | (($c[0] // {}) | if .type == "paragraph" then ((.content // []) | map(inline) | join("")) else "" end) as $first
    | ($c[1:] | map(adf($ind + "  ")) | map(select(. != "")) | join("\n\n")) as $rest
    | "\($ind)\(if $ordered then "\($n). " else "- " end)\($first)" + (if $rest == "" then "" else "\n\($rest)" end);
  if type != "object" then ""
  elif .type == "doc" then ((.content // []) | map(adf("")) | map(select(. != "")) | join("\n\n"))
  elif .type == "paragraph" then ((.content // []) | map(inline) | join(""))
  elif .type == "heading" then ("#" * (.attrs.level // 1)) + " " + ((.content // []) | map(inline) | join(""))
  elif .type == "rule" then "\($ind)---"
  elif .type == "blockquote" then (((.content // []) | map(adf($ind)) | join("\n\n")) | split("\n") | map("\($ind)> " + .) | join("\n"))
  elif .type == "codeBlock" then "\($ind)```\(.attrs.language // "")\n\((.content // []) | map(.text // "") | join("") | split("\n") | map($ind + .) | join("\n"))\n\($ind)```"
  elif .type == "bulletList" then ((.content // []) | map(item(false; null)) | join("\n"))
  elif .type == "orderedList" then ((.attrs.order // 1) as $start | (.content // []) | to_entries | map(.key as $k | .value | item(true; $start + $k)) | join("\n"))
  elif .type == "listItem" then item(false; null)
  elif .type == "table" then table
  elif .type == "mediaSingle" or .type == "mediaGroup" then ((.content // []) | map(adf($ind)) | join("\n"))
  elif .type == "media" then "\($ind)[image: \(.attrs.alt // .attrs.id // "media")]"
  elif .type == "panel" then (((.content // []) | map(adf($ind)) | join("\n\n")) | split("\n") | map("\($ind)> " + .) | join("\n"))
  elif .type == "expand" or .type == "nestedExpand" then ((.content // []) | map(adf($ind)) | join("\n\n"))
  elif .type == "taskList" then ((.content // []) | map(adf($ind)) | join("\n"))
  elif .type == "taskItem" then "\($ind)- [\(if .attrs.state == "DONE" then "x" else " " end)] \((.content // []) | map(if .type == "paragraph" then ((.content // []) | map(inline) | join("")) else adf($ind) end) | join(" "))"
  else ((.content // []) | map(adf($ind)) | map(select(. != "")) | join("\n\n"))
  end;
def adf: adf("");'

linear() {
  local id=$1 out args=(issue view "$1" --json --no-download --no-input)
  $full || args+=(--no-comments)
  out=$(command linear "${args[@]}" 2>/dev/null) || return 1
  jq -c --argjson full "$full" '
    {tool: "linear", id: .identifier, title, url, status: .state.name}
    + if $full then {body: (.description // ""),
        comments: [(.comments // [])[] | {author: (.user.name // .externalUser.name), created: .createdAt, body}],
        raw: .} else {} end' <<<"$out"
}

jira() {
  local id out site fields=summary,status
  id=$(tr '[:lower:]' '[:upper:]' <<<"$1")
  $full && fields='*all'
  out=$(acli jira workitem view "$id" --fields "$fields" --json 2>/dev/null) || return 1
  site=$(acli jira auth status 2>/dev/null | sed -n 's/^ *Site: *//p')
  jq -c --argjson full "$full" --arg site "$site" "$ADF"'
    {tool: "jira", id: .key, title: .fields.summary,
     url: (if $site == "" then null else "https://\($site)/browse/\(.key)" end),
     status: .fields.status.name}
    + if $full then {body: (.fields.description | adf),
        comments: [(.fields.comment.comments // [])[] | {author: .author.displayName, created, body: (.body | adf)}],
        raw: .} else {} end' <<<"$out"
}

tk() {
  local id out
  id=$(tr '[:upper:]' '[:lower:]' <<<"$1")
  out=$(command tk show "$id" 2>/dev/null) || return 1
  jq -Rsc --argjson full "$full" --arg id "$id" '
    (split("\n")) as $lines
    | ($lines | index("---")) as $a
    | ($lines[$a + 1:] | index("---") + $a + 1) as $b
    | ($lines[$b + 1:] | map(select(startswith("# "))) | first // "" | ltrimstr("# ")) as $title
    | ([$lines[$a + 1:$b][] | capture("^status: *(?<s>.*)$").s] | first) as $status
    | {tool: "tk", id: $id, title: $title, url: null, status: $status}
      + if $full then {body: ($lines[$b + 1:] | join("\n") | sub("^\\s*# [^\n]*\n"; "") | sub("^\\s+"; "")),
          comments: [], raw: .} else {} end' <<<"$out"
}

github() {
  local n=${1#\#} out fields=number,title,url,state
  $full && fields+=,body,comments,labels,assignees,author,createdAt
  out=$(gh issue view "$n" --json "$fields" 2>/dev/null) || return 1
  jq -c --argjson full "$full" '
    {tool: "github", id: "#\(.number)", title, url, status: .state}
    + if $full then {body: (.body // ""),
        comments: [(.comments // [])[] | {author: .author.login, created: .createdAt, body}],
        raw: .} else {} end' <<<"$out"
}

case $tool in
  linear|jira) pattern='(^|[^a-z0-9])[a-z][a-z0-9]*-[0-9]+' ;;
  tk) pattern='(^|[^a-z0-9])[a-z0-9]+-[0-9a-f]{4}([^0-9a-z]|$)' ;;
  github) pattern='#[0-9]+|(^|/)[0-9]+-' ;;
  *) echo "get-ticket: unknown ticket.tool: $tool" >&2; exit 2 ;;
esac

while read -r id; do
  id=$(sed -E 's/^[^A-Za-z0-9#]+//; s/[^A-Za-z0-9]+$//' <<<"$id")
  [[ -n $id ]] || continue
  "$tool" "$id" && exit 0
done < <(candidates "$pattern")
exit 1
